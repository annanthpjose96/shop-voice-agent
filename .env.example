# --- LLM (any OpenAI-compatible provider) ---
# Free option: Groq. Get a key at https://console.groq.com (no credit card).
LLM_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
MODEL=llama-3.3-70b-versatile

# Other providers: just change these three lines.
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   MODEL=gemini-2.5-flash
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama   MODEL=llama3.1

# --- Twilio ---
TWILIO_AUTH_TOKEN=
PUBLIC_HOST=your-subdomain.ngrok.app   # no scheme, no trailing slash
VALIDATE_TWILIO_SIGNATURE=true         # set false only for local debugging

# Where "talk to a person" calls get forwarded (E.164). Leave empty to disable transfers.
HUMAN_TRANSFER_NUMBER=

# --- Voice (Twilio ConversationRelay providers) ---
TTS_PROVIDER=Google
TTS_VOICE=en-US-Journey-O

DATABASE_PATH=data/shop.db
BUSINESS_CONFIG=business.json
